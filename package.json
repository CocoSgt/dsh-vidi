{
  "name": "dsh-live",
  "version": "0.1.0",
  "description": "Watch live streams inside DeepSeek Harness with real-time bilingual subtitles — pull any live stream, subtitle it in real time or with a polished delay, restream and save it",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.mjs",
  "exports": {
    ".": { "default": "./lib/index.mjs" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "README.zh-CN.md"],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "hls.js": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2"
  },
  "keywords": ["dsh", "deepseek-harness", "live", "subtitles", "translation", "restream"]
}
